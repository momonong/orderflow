# Review-only drop-in candidate for the existing orderflow.service.
# Do not install or restart before the pinned release, migration, resource,
# credential and Broker admission gates in docs/broker-integration.md are approved.
# Inherit the reviewed base unit's User/Group, login-auth credential, state
# directory, hardening, resource limits and restart policy.
[Service]
LoadCredentialEncrypted=client_token:/etc/api-quota-broker/credentials/client_token.cred
ExecStart=
ExecStart=/opt/orderflow/current/.venv/bin/python -u -m orderflow.app --host 127.0.0.1 --port 18081 --data-dir /var/lib/orderflow --public-origin https://momonong.me --recognition-mode broker --broker-config /etc/orderflow/broker.json --broker-token-file %d/client_token
