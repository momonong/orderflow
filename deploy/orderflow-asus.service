[Unit]
Description=OrderFlow PDF test application on ASUS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orderflow
Group=orderflow
StateDirectory=orderflow
StateDirectoryMode=0700
LoadCredential=login-auth:/etc/orderflow/login-auth.caddy
WorkingDirectory=/opt/orderflow/current
ExecStart=/opt/orderflow/current/.venv/bin/python -u -m orderflow.app --host 127.0.0.1 --port 18081 --data-dir /var/lib/orderflow --public-origin https://momonong.me
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
MemoryMax=768M
TasksMax=64

[Install]
WantedBy=multi-user.target
